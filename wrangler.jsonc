{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulktrack-api",
  "main": "./build/worker.mjs",
  "compatibility_date": "2025-04-08",
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bulktrack-db",
